{
  "name": "mcp-firewall",
  "version": "0.1.0",
  "private": true,
  "description": "Local firewall for AI agents: intercepts MCP tool calls, enforces explicit policy, shows decisions live.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:docker": "REQUIRE_DOCKER=1 vitest run tests/upstream-docker.test.ts",
    "start": "node --import tsx src/index.ts --config config/firewall.yaml",
    "dev": "node --import tsx src/index.ts --config config/firewall.yaml",
    "mock-server": "tsx demo/mock-server.ts",
    "demo": "tsx demo/scenarios.ts",
    "demo:pitch": "tsx demo/pitch.ts",
    "demo:env": "tsx demo/env-suite.ts",
    "sandbox:build": "docker build -t mcp-firewall-sandbox:dev demo/sandbox",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
