# Dependencies
node_modules/

# Logs, including the optional redacted JSONL event log (design §8)
*.log
*.jsonl

# Env files: the policy protects **/.env, so never commit one
.env
.env.*
# ...except the demo project's dummy one, which the sandbox demo shows never leaves it.
!demo/project/.env

# OS / editor
.DS_Store
.vscode/
.idea/

# Test coverage
coverage/

# Per-developer firewall configs (docs/SETUP.md §2): local paths and policy, never shared
config/*.local.yaml

# Claude Code per-user settings
.claude/settings.local.json

# Scratch scripts
*.tmp.ts
